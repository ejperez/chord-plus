{
  "name": "chord-plus",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/chord-plus.umd.js",
  "module": "./dist/chord-plus.es.js",
  "exports": {
    ".": {
      "import": "./dist/chord-plus.es.js",
      "require": "./dist/chord-plus.umd.js",
      "types": "./dist/chord-plus.d.ts"
    },
    "./css": "./dist/chord-plus.css"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.js",
    "build": "vite build && cp lib/main.d.ts dist/chord-plus.d.ts",
    "build:demo": "vite build --config vite.demo.config.js",
    "deploy:demo": "npm run build:demo && gh-pages -d demo/dist",
    "preview": "vite preview",
    "test": "node --test"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "sass-embedded": "^1.104.0",
    "vite": "^8.3.0"
  }
}
